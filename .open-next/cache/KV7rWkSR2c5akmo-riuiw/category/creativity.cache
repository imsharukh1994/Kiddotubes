\":\"https://i.ytimg.com/vi/tMqZTzIFz3Q/mqdefault.jpg\",\"width\":320,\"height\":180},\"high\":{\"url\":\"https://i.ytimg.com/vi/tMqZTzIFz3Q/hqdefault.jpg\",\"width\":480,\"height\":360},\"standard\":{\"url\":\"https://i.ytimg.com/vi/tMqZTzIFz3Q/sddefault.jpg\",\"width\":640,\"height\":480},\"maxres\":{\"url\":\"https://i.ytimg.com/vi/tMqZTzIFz3Q/maxresdefault.jpg\",\"width\":1280,\"height\":720}}},\"categoryLabel\":\"Creativity\"}]]}]]}]]}]\n"}